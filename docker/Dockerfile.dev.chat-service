# Development Dockerfile with hot reload support
FROM gradle:8.5-jdk21

WORKDIR /app

# Copy Gradle configuration files first (for better caching)
COPY chat-service/build.gradle ./
COPY chat-service/gradle.properties ./
COPY chat-service/settings.gradle ./
COPY chat-service/lombok.config ./

# Download dependencies (cached layer)
RUN gradle dependencies --no-daemon || true

# Copy source code (will be overridden by volume mount in docker-compose)
COPY chat-service/src ./src

# Expose port
EXPOSE ${CHAT_SERVICE_PORT}

# Run with continuous build for hot reload
# Spring Boot DevTools will handle automatic restarts
ENTRYPOINT ["./gradlew", "bootRun", "--no-daemon"]

