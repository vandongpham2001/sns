# Development Dockerfile with hot reload support
FROM gradle:8.5-jdk21

WORKDIR /app

# Copy Gradle Wrapper
COPY profile-service/gradle ./gradle
COPY profile-service/gradlew ./gradlew
COPY profile-service/gradlew.bat ./gradlew.bat
# RUN chmod +x gradlew

# Copy Gradle configuration files (for better caching)
COPY profile-service/build.gradle ./
COPY profile-service/gradle.properties ./
COPY profile-service/settings.gradle ./
COPY profile-service/lombok.config ./

# Download dependencies (cached layer)
RUN ./gradlew dependencies --no-daemon || true

# Copy source code (will be overridden by volume mount in docker-compose)
COPY profile-service/src ./src

# Expose port
ARG PROFILE_SERVICE_PORT=8081
EXPOSE ${PROFILE_SERVICE_PORT}

# Run with continuous build for hot reload
# Spring Boot DevTools will handle automatic restarts
ENTRYPOINT ["./gradlew", "bootRun", "--no-daemon"]

